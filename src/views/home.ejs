<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Home</title>
        <link rel="stylesheet" href="css/style.css" />
    </head>
    <body>
        <div class="topnav">
            <a href="/" class="active">Home</a>
            <a href="/create">Create new user</a>
        </div>
        <h1 class="title">List user</h1>
        <table id="customers">
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Name</th>
                <th>City</th>
                <th>Actions</th>
            </tr>
            <% listUsers.forEach(function(user) { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.email %></td>
                    <td><%= user.name %></td>
                    <td><%= user.city %></td>
                    <td>
                        <a href="/update">Edit</button>
                        <button type="button">Delete</button>
                    </td>
                </tr>
            <% }); %> 
        </table>
    </body>
</html>
